<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <ProjectReference Include="..\..\src\HDRCalibrate\HDRCalibrate.csproj" />
    <ProjectReference Include="..\..\src\HDRCalibrate.Dwm\HDRCalibrate.Dwm.csproj" />
    <ProjectReference Include="..\..\installer\HDRCalibrate.Setup\HDRCalibrate.Setup.csproj" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
  <!-- The view-model tests bind startup approvals to the helper's file version,
       so the helper must sit next to HDRCalibrate.exe in this output as well. -->
  <Target Name="CopyDwmHelper" AfterTargets="Build">
    <MSBuild Projects="..\..\src\HDRCalibrate.DwmHelper\HDRCalibrate.DwmHelper.csproj"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="DwmHelperTargetPath" />
    </MSBuild>
    <ItemGroup>
      <DwmHelperFiles Include="@(DwmHelperTargetPath)" />
      <DwmHelperFiles Include="@(DwmHelperTargetPath->'%(FullPath).config')"
                      Condition="Exists('%(DwmHelperTargetPath.FullPath).config')" />
    </ItemGroup>
    <Copy SourceFiles="@(DwmHelperFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
