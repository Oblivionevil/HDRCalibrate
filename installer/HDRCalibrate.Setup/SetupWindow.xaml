<Window x:Class="HDRCalibrate.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/HDRCalibrate.Setup;component/Assets/HDRCalibrate.ico"
        Width="660" Height="480" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Image Source="/HDRCalibrate.Setup;component/Assets/HDRCalibrate.png" Width="44" Height="44"
                   Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubheadingText" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,16" Padding="20">
            <Grid>
                <StackPanel x:Name="OptionsPanel">
                    <TextBlock x:Name="IntroText" TextWrapping="Wrap" />
                    <TextBlock x:Name="TargetText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
                    <CheckBox x:Name="DesktopCheck" Margin="0,18,0,0" />
                    <CheckBox x:Name="AutostartCheck" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelRaisedBrush}" BorderThickness="0" />
                </StackPanel>
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                    <CheckBox x:Name="LaunchCheck" Margin="0,18,0,0" IsChecked="True" Visibility="Collapsed" />
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" MinWidth="110" Click="OnSecondary" IsCancel="True" />
            <Button x:Name="PrimaryButton" MinWidth="130" Margin="10,0,0,0" Click="OnPrimary" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
