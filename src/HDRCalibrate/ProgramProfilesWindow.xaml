<Window x:Class="HDRCalibrate.ProgramProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDR Calibrate · Programme" Width="960" Height="760"
        MinWidth="800" MinHeight="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Programme" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Festen Farbraum gezielt beim Programmstart erzwingen" Style="{StaticResource LabelStyle}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,14" Padding="14">
            <StackPanel>
                <TextBlock Text="Nur Starts aus dieser Liste · keine Hooks" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Normale Verknüpfungen und bereits laufende Programme werden nicht verändert. Unterstützt: Brave, Chrome, Edge und Chromium. Keine automatische Programmaktivierung beim Windows-Start."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="AddButton" Content="EXE hinzufügen…" Click="OnAdd" Margin="0,0,8,0" />
                <Button Content="Neu laden" Click="OnReload" />
            </StackPanel>
            <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Style="{StaticResource LabelStyle}" />
        </DockPanel>
        <Grid Grid.Row="3">
            <ListBox x:Name="ProgramList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Gespeicherte Programmprofile">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="225" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" Foreground="{StaticResource AccentBlueBrush}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyLabel" Text="Noch keine Programme. Wähle die EXE des gewünschten Browsers aus."
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
        </Grid>
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="Startprofil für das ausgewählte Programm" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModeSelector" SelectedValuePath="Mode"
                              SelectionChanged="OnModeChanged" AutomationProperties.Name="Erzwungener Farbraum">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="SaveButton" Grid.Column="1" Content="Profil speichern" Click="OnSave" Margin="10,0,0,0" />
                </Grid>
                <TextBlock x:Name="ModeDescription" Foreground="#F2B96B" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="58" />
                <TextBlock x:Name="ArgumentsLabel" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <DockPanel Margin="0,14,0,0">
                    <Button x:Name="LaunchButton" Content="Mit gespeichertem Profil starten" Click="OnLaunch" DockPanel.Dock="Right"
                            Background="{StaticResource AccentBrush}" Foreground="#062319" />
                    <Button x:Name="RemoveButton" Content="Aus Liste entfernen" Click="OnRemove" HorizontalAlignment="Left" />
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="Schließen" Click="OnClose" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
