<Window x:Class="HDRCalibrate.ProgramProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDR Calibrate · Programme" Icon="/HDRCalibrate;component/Assets/HDRCalibrate.ico" Width="1060" Height="860"
        MinWidth="900" MinHeight="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaisedBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Programme" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="SDR-Gamma für laufende Programme und separate Browser-Startprofile" Style="{StaticResource LabelStyle}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,14" Padding="14">
            <StackPanel>
                <TextBlock Text="SDR-Gamma bewusst pro Sitzung aktivieren" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Übernimmt das aktive SDR-Gamma des Hauptfensters; unbekannte/HDR-Ausgaben bleiben ausgeschlossen. Experimentell; VRR/Latenz nicht bestätigt."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="AddButton" Content="EXE hinzufügen…" Click="OnAdd" Margin="0,0,8,0" />
                <Button x:Name="ReloadButton" Content="Neu laden" Click="OnReload" />
            </StackPanel>
            <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Style="{StaticResource LabelStyle}" />
        </DockPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ListBox x:Name="ProgramList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Gespeicherte Programmprofile">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                                <TextBlock Text="{Binding GammaLabel}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ModeLabel}" Foreground="{StaticResource AccentBlueBrush}"
                                           FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyLabel" Text="Noch keine Programme. Wähle die EXE des gewünschten Programms aus."
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                           Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                <Button x:Name="RemoveButton" Grid.Row="1" Content="Aus Liste entfernen" Click="OnRemove"
                        HorizontalAlignment="Left" Margin="0,10,0,0" />
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock x:Name="SelectedProgramLabel" Text="Programm auswählen" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                            <CheckBox x:Name="ForceSdrGammaToggle" Content="SDR-Gamma-Erzwingen für dieses Programm erlauben"
                                      Checked="OnGammaToggleChanged" Unchecked="OnGammaToggleChanged"
                                      AutomationProperties.Name="SDR-Gamma-Erzwingen für dieses Programm erlauben">
                                <CheckBox.ContentTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                                </CheckBox.ContentTemplate>
                            </CheckBox>
                            <TextBlock Text="Programm selbst starten. Nur eine Programm-/Fenstersitzung gleichzeitig; beim Schließen dieses Fensters endet das Erzwingen. Speichern aktiviert nichts automatisch."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="12" />
                            <TextBlock x:Name="GammaHintLabel" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,7,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="GammaTestButton" Content="Gamma 5 s testen" Click="OnGammaTest"
                                        Padding="11,8" Margin="0,0,6,6" />
                                <Button x:Name="GammaActivateButton" Content="Gamma erzwingen" Click="OnGammaActivate"
                                        Padding="11,8" Margin="0,0,6,6"
                                        Background="{StaticResource AccentBrush}" Foreground="#062319" />
                                <Button x:Name="GammaStopButton" Content="Erzwingen stoppen" Click="OnGammaStop"
                                        Padding="11,8" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock x:Name="GammaStatusLabel" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="GammaTargetLabel" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,14" />
                            <TextBlock Text="Browser-Startprofil" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ComboBox x:Name="ModeSelector" SelectedValuePath="Mode"
                                      SelectionChanged="OnModeChanged" AutomationProperties.Name="Erzwungener Farbraum">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="ModeDescription" Foreground="#F2B96B" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="12" />
                            <TextBlock x:Name="ArgumentsLabel" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="SaveButton" Content="Profil speichern" Click="OnSave" Margin="0,0,8,0" />
                        <Button x:Name="LaunchButton" Content="Mit gespeichertem Profil starten" Click="OnLaunch"
                                Background="{StaticResource AccentBrush}" Foreground="#062319" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="Schließen" Click="OnClose" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
